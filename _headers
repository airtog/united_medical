# Cloudflare Pages custom headers
# P1-2: Fix caching — was max-age=0, must-revalidate on everything

# HTML pages: short cache, always revalidate
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: public, max-age=3600, must-revalidate

# CSS and JS: long-lived immutable (versioned via ?v= query strings)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images: long-lived (content-addressed or rarely changing)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts served from our domain (if any)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Sitemap and robots: moderate cache
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
